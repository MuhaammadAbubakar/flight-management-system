    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select f.flight_number, f.origin, f.destination,\n  si.seat_class as klass, si.total_seats, si.booked_seats,\n  round(100.0 * si.booked_seats / nullif(si.total_seats, 0), 1) as load_factor_pct,\n  round(si.booked_seats * si.price, 2) as revenue\nfrom flights f\njoin seat_inventory si on si.flight_id = f.id\nwhere f.departure_time::date = current_date\n  and f.departure_time < now()\norder by f.flight_number, si.seat_class",
        "options": {}
      },
      "id": "6ee75d36-edb4-437c-83a7-51c753fb087a",
      "name": "Ops: departed today",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        544,
        2704
      ],
      "credentials": {
        "postgres": {
          "id": "3FJYpBrOCXdcCPGP",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(r => r.json);\nconst totalRevenue = rows.reduce((s, r) => s + parseFloat(r.revenue || 0), 0);\nconst avgLoad = rows.length ? (rows.reduce((s, r) => s + parseFloat(r.load_factor_pct || 0), 0) / rows.length).toFixed(1) : '0';\nconst table = ['Flight | Class | Load% | Revenue'].concat(rows.map(r => `${r.flight_number} ${r.origin}-${r.destination} | ${r.klass} | ${r.load_factor_pct}% | ${r.revenue}`)).join('\\n');\nreturn [{ json: { totalRevenue, avgLoad, table } }];"
      },
