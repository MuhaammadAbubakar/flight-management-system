    {
      "parameters": {
        "jsCode": "const recent = $('Fraud: recent bookings').item.json;\nconst v = $json;\nlet score = 0;\nconst reasons = [];\nif (Number(v.bookings_last_10m) >= 3) { score += 50; reasons.push(`${v.bookings_last_10m} bookings in 10m`); }\nif (Number(v.bookings_24h) >= 6) { score += 40; reasons.push(`${v.bookings_24h} bookings in 24h`); }\nreturn [{ json: { booking_id: recent.id, email: recent.email, score, reasons, reasons_text: reasons.join(' | ') } }];"
      },
