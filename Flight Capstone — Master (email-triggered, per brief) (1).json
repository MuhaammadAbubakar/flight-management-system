    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with promotable as (\n  select w.id\n  from waitlist w\n  join seat_inventory si on si.flight_id = w.flight_id and si.seat_class = w.seat_class\n  where w.status = 'WAITING' and si.booked_seats < si.total_seats\n  order by w.priority desc, w.created_at asc\n  limit 25\n  for update skip locked\n)\nupdate waitlist w set status = 'PROMOTED'\nfrom promotable pr where w.id = pr.id\nreturning w.id",
        "options": {}
      },
