    {
      "parameters": {
        "jsCode": "const TZ = { DXB: 'Asia/Dubai', LHR: 'Europe/London', KHI: 'Asia/Karachi', JFK: 'America/New_York' };\nreturn $input.all().map(r => ({\n  json: {\n    ...r.json,\n    local_departure: new Date(r.json.dep_utc).toLocaleString('en-GB', { timeZone: TZ[r.json.origin] || 'UTC' }),\n    tz: TZ[r.json.origin] || 'UTC'\n  }\n}));"
      },
