    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  (select count(*) from bookings b2 where b2.passenger_email = $1 and b2.created_at > now() - interval '10 minutes') as bookings_last_10m,\n  (select count(*) from bookings b3 where b3.passenger_email = $1 and b3.created_at > now() - interval '24 hours') as bookings_24h",
        "options": {
          "queryReplacement": "={{ $json.email }}"
        }
      },
      "id": "9744501f-921f-4eb8-a48c-fa03627271fc",
      "name": "Fraud: velocity signals",
      "type": "n8n-nodes-base.postgres",
