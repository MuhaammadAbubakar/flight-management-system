    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select b.id as booking_id, b.passenger_email as email, b.passenger_name as name, f.flight_number, f.origin, f.destination, f.departure_time as dep_utc\nfrom bookings b\njoin flights f on f.id = b.flight_id\nwhere b.status = 'CONFIRMED'\n  and f.status = 'SCHEDULED'\n  and b.reminder_sent = false\n  and f.departure_time between now() + interval '24 hours' and now() + interval '48 hours'",
        "options": {}
      },
